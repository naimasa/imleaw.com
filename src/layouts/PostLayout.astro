---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '../components/content/CategoryBadge.astro';
import { siteConfig } from '../config/site.config';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const date = post.data.date.toLocaleDateString('ja-JP', { year:'numeric', month:'long', day:'numeric', timeZone:'Asia/Tokyo' });
const description = `${post.data.title} — ${date}のイム・レーオのブログ記事です。`;
---
<BaseLayout title={post.data.title} description={description} canonicalPath={post.data.permalink} breadcrumbs={[{label:'Blog',href:'/blogs/'},{label:post.data.title}]}>
  <article class="post container container--narrow" data-pagefind-body>
    <header class="post-header"><div class="cluster">{post.data.categories.map((category) => <CategoryBadge slug={category} />)}</div><h1>{post.data.title}</h1><time datetime={post.data.date.toISOString()}>{date}</time></header>
    {post.data.heroImage && <Image class="hero-image" src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} widths={[720,960,1280]} sizes="(max-width: 768px) 100vw, 768px" format="webp" loading="eager" />}
    <div class="prose"><slot /></div>
    <footer class="post-footer"><a href="/blogs/">← ブログ一覧へ</a><a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(new URL(post.data.permalink, siteConfig.url).href)}`} target="_blank" rel="noopener">この記事をシェア<span class="visually-hidden">（新しいタブ）</span></a></footer>
  </article>
</BaseLayout>
<style>.post{padding-block:var(--space-7) var(--space-10)}.post-header{text-align:center;margin-bottom:var(--space-7)}.post-header .cluster{justify-content:center}.post-header h1{margin:var(--space-4) 0}.post-header time{color:var(--color-text-muted);font-size:var(--font-size-sm)}.hero-image{width:100%;max-height:34rem;object-fit:cover;margin-bottom:var(--space-8);border-radius:var(--radius-lg);box-shadow:var(--shadow-md)}.post-footer{display:flex;justify-content:space-between;gap:var(--space-4);margin-top:var(--space-9);padding-top:var(--space-5);border-top:1px solid var(--color-border);font-weight:700}</style>
