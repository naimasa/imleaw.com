---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../../layouts/PostLayout.astro';
import { parsePermalink } from '../../../../lib/permalink';
export async function getStaticPaths() {
  return (await getCollection('posts')).map((post) => { const parsed = parsePermalink(post.data.permalink); if (parsed.kind !== 'post') throw new Error(`Invalid post permalink: ${post.data.permalink}`); return { params:{year:parsed.year,month:parsed.month,day:parsed.day,slug:decodeURIComponent(parsed.slug)}, props:{post} }; });
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<PostLayout post={post}><Content /></PostLayout>
