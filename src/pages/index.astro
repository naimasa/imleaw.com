---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/content/Hero.astro';
import InstagramGrid from '../components/embed/InstagramGrid.astro';
import ContactSection from '../components/embed/ContactSection.astro';

const home = (await getCollection('pages')).find((page) => page.data.permalink === '/');
const HomeContent = home ? (await render(home)).Content : null;
---
<BaseLayout>
  <Hero />

  <!-- Intro & Welcome -->
  <section class="section intro">
    <div class="container container--narrow">
      <p class="eyebrow">Welcome to Im Leaw</p>
      <h2>食卓に寄り添うパンを、須坂から。</h2>
      <p>
        国産小麦を中心に、時間をかけて発酵させたパンを焼いています。<br />
        少人数のパン教室では、ご家庭でも繰り返し楽しめるパン作りを基本からお伝えします。
      </p>
      {HomeContent && <div class="home-note prose"><HomeContent /></div>}
    </div>
  </section>

  <!-- Instagram / News & Bakery Days (Spotlight) -->
  <section class="section instagram">
    <div class="container">
      <header class="section-title">
        <p class="eyebrow">Instagram / News</p>
        <h2>工房からの便り・最新の営業日</h2>
        <p class="section-subtitle">日々の焼き上がりや営業カレンダーをInstagramにて発信しています</p>
      </header>
      <InstagramGrid />
      <p class="more">
        <a class="button" href="/instagram/">すべての投稿を見る</a>
      </p>
    </div>
  </section>

  <!-- Lessons & Courses -->
  <section class="section lessons">
    <div class="container">
      <header class="section-title">
        <p class="eyebrow">Lessons & Courses</p>
        <h2>パンのある暮らしを、一緒に</h2>
      </header>
      <div class="course-grid">
        <a class="course surface" href="/about-the-lesson/">
          <span>01</span>
          <h3>パン教室について</h3>
          <p>少人数で、基本から丁寧に。レッスンの考え方をご紹介します。</p>
        </a>
        <a class="course surface" href="/basic-course/">
          <span>02</span>
          <h3>Basic course</h3>
          <p>はじめての方にもおすすめ。食卓に合わせやすいパンを学びます。</p>
        </a>
        <a class="course surface" href="/advanced-course/">
          <span>03</span>
          <h3>Advanced course</h3>
          <p>成形や素材の幅を広げて、さらに奥深いパン作りへ。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact & Access -->
  <section class="section">
    <div class="container container--narrow">
      <ContactSection />
    </div>
  </section>
</BaseLayout>

<style>
.intro{text-align:center}
.intro h2{font-size:var(--font-size-2xl)}
.intro>div>p:not(.eyebrow){font-size:var(--font-size-md)}
.section-subtitle{margin-top:var(--space-2);color:var(--color-text-muted);font-size:var(--font-size-md)}
.home-note{margin:var(--space-6) auto 0;padding-top:var(--space-5);border-top:1px solid var(--color-border)}
.lessons,.instagram{background:var(--color-surface-warm)}
.course-grid{display:grid;gap:var(--space-5)}
.course{display:block;padding:var(--space-6);color:var(--color-text);text-decoration:none}
.course>span{color:var(--color-accent);font-family:var(--font-display);font-size:var(--font-size-lg)}
.course h3{margin:var(--space-3) 0}
.course p{margin:0;color:var(--color-text-muted)}
.course:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}
.more{margin:var(--space-8) 0 0;text-align:center}
@media(min-width:48rem){
  .course-grid{grid-template-columns:repeat(3,1fr)}
}
</style>

