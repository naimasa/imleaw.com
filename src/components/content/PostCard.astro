---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CategoryBadge from './CategoryBadge.astro';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const excerpt = (post.body ?? '').replace(/!\[[^\]]*\]\([^)]*\)|[#*_>`\[\]]|https?:\/\/\S+/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 108);
const date = post.data.date.toLocaleDateString('ja-JP', { year:'numeric', month:'short', day:'numeric', timeZone:'Asia/Tokyo' });
---
<article class="card surface">
  <a class="image-link" href={post.data.permalink} tabindex="-1">{post.data.heroImage ? <Image src={post.data.heroImage} alt="" widths={[400,640]} sizes="(max-width: 768px) 100vw, 360px" format="webp" loading="lazy" /> : <span class="placeholder" aria-hidden="true">Im Leaw</span>}</a>
  <div class="body"><div class="meta"><time datetime={post.data.date.toISOString()}>{date}</time>{post.data.categories[0] && <CategoryBadge slug={post.data.categories[0]} />}</div><h3><a href={post.data.permalink}>{post.data.title}</a></h3>{excerpt && <p>{excerpt}…</p>}</div>
</article>
<style>.card{overflow:hidden}.image-link{display:block;aspect-ratio:4/3;overflow:hidden;background:var(--color-surface-warm);text-decoration:none}.image-link :global(img){width:100%;height:100%;object-fit:cover;transition:transform var(--transition)}.card:hover .image-link :global(img){transform:scale(1.025)}.placeholder{display:grid;height:100%;place-items:center;color:var(--color-primary);font-family:var(--font-display);font-size:var(--font-size-xl)}.body{padding:var(--space-5)}.meta{display:flex;align-items:center;justify-content:space-between;gap:var(--space-2);color:var(--color-text-muted);font-size:var(--font-size-xs)}h3{margin:var(--space-3) 0;font-size:var(--font-size-lg)}h3 a{color:var(--color-text);text-decoration:none}p{margin:0;color:var(--color-text-muted);font-size:var(--font-size-sm);line-height:var(--line-base)}</style>
