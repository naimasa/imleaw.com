---
import { siteConfig } from '../../config/site.config';
const hero = '/wp-content/uploads/2024/09/IMG_1527-scaled.jpg';
---
<section class="hero">
  <img src={hero} alt="イム・レーオで焼き上げたパン" width="1920" height="1440" fetchpriority="high" />
  <div class="overlay">
    <p class="eyebrow">Small bakery in Suzaka</p>
    <h1>
      <span class="hero-line">パンの香りから、</span><br />
      <span class="hero-line">小さな幸せを。</span>
    </h1>
    <p>長野県須坂市。ゆっくり発酵させたパンの販売と、暮らしに寄り添うパン教室を開いています。</p>
    <div class="cluster">
      <a class="button" href="/about-the-lesson/">パン教室について</a>
      <a class="button button--secondary" href="/blogs/">日々の便り</a>
      <a class="button button--secondary" href={siteConfig.store.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>
  </div>
</section>
<style>
.hero{position:relative;display:grid;min-height:clamp(34rem,72vh,48rem);overflow:hidden;background:var(--color-surface-warm)}
.hero>img{position:absolute;width:100%;height:100%;object-fit:cover}
.hero::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,var(--color-hero-overlay-strong) 0%,var(--color-hero-overlay) 42%,var(--color-hero-shade) 75%)}
.overlay{z-index:1;align-self:center;width:min(calc(100% - 2 * var(--space-5)),var(--container));margin-inline:auto}
.overlay h1{margin:var(--space-3) 0 var(--space-5);font-size:var(--font-size-3xl);line-height:1.25}
.hero-line{display:inline-block;white-space:nowrap}
.overlay>p:not(.eyebrow){max-width:33rem;margin-bottom:var(--space-6);font-size:var(--font-size-md)}
@media(max-width:40rem){
  .hero::after{background:var(--color-hero-overlay)}
  .overlay h1{font-size:var(--font-size-2xl)}
}
@media(min-width:48rem){
  .overlay{width:min(calc(100% - 2 * var(--space-8)),var(--container))}
}
</style>

