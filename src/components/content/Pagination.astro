---
interface Props { currentPage: number; totalPages: number; basePath: string }
const { currentPage, totalPages, basePath } = Astro.props;
const href = (page: number) => page === 1 ? basePath : `${basePath}page/${page}/`;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1).filter((page) => page === 1 || page === totalPages || Math.abs(page - currentPage) <= 2);
---
{totalPages > 1 && <nav class="pagination" aria-label="ページネーション">{currentPage > 1 && <a class="direction" href={href(currentPage - 1)} rel="prev">← 前へ</a>}<ol>{pages.map((page, i) => <><li><a href={href(page)} aria-current={page === currentPage ? 'page' : undefined}>{page}</a></li>{pages[i + 1] && pages[i + 1] - page > 1 && <li aria-hidden="true">…</li>}</>)}</ol>{currentPage < totalPages && <a class="direction" href={href(currentPage + 1)} rel="next">次へ →</a>}</nav>}
<style>.pagination{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-8)}.pagination ol{display:flex;align-items:center;gap:var(--space-2);margin:0;padding:0;list-style:none}.pagination a{display:grid;min-width:2.75rem;min-height:2.75rem;padding:var(--space-2);place-items:center;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface);font-weight:700;text-decoration:none}.pagination a[aria-current=page]{background:var(--color-primary);color:var(--color-white);border-color:var(--color-primary)}.pagination .direction{padding-inline:var(--space-4)}</style>
