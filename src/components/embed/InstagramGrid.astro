---
import { siteConfig } from '../../config/site.config';
import instagramData from '../../data/instagram.json';

interface Pin {
  image: string;
  url?: string;
  caption?: string;
}

const pins: Pin[] = instagramData.pins && instagramData.pins.length > 0
  ? instagramData.pins
  : [
      { image: '/wp-content/uploads/2024/09/IMG_1527-scaled.jpg', url: siteConfig.store.instagramUrl, caption: 'イム・レーオのパン' },
      { image: '/wp-content/uploads/2024/07/IMG_1422-scaled.jpg', url: siteConfig.store.instagramUrl, caption: '工房の風景' },
      { image: '/wp-content/uploads/2024/06/IMG_1323-scaled.jpg', url: siteConfig.store.instagramUrl, caption: '焼き立てパン' },
    ];
---
<div class="instagram-grid">
  {pins.map((pin, i) => {
    const targetUrl = pin.url?.trim() || siteConfig.store.instagramUrl;
    const label = pin.caption?.trim() || `イム・レーオのパンと工房の風景 ${i + 1}`;
    return (
      <a class="pin-item" href={targetUrl} target="_blank" rel="noopener noreferrer" title={label}>
        <img src={pin.image} alt={label} width="640" height="640" loading="lazy" />
        <span class="pin-overlay">
          <span class="pin-caption">{label}</span>
          <span class="pin-icon" aria-hidden="true">↗</span>
        </span>
      </a>
    );
  })}
</div>
<style>
.instagram-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-3)}
.pin-item{position:relative;display:block;aspect-ratio:1;overflow:hidden;border-radius:var(--radius-md);background:var(--color-surface-warm);box-shadow:var(--shadow-sm);text-decoration:none}
.pin-item img{width:100%;height:100%;object-fit:cover;transition:transform 0.35s ease, filter 0.35s ease}
.pin-overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:var(--space-3);background:linear-gradient(to top, rgba(44, 30, 22, 0.78) 0%, rgba(44, 30, 22, 0.2) 40%, transparent 70%);color:var(--color-white);opacity:0;transition:opacity 0.25s ease}
.pin-caption{font-size:var(--font-size-xs);font-weight:600;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pin-icon{position:absolute;top:var(--space-3);right:var(--space-3);display:grid;place-items:center;width:1.75rem;height:1.75rem;border-radius:50%;background:rgba(255, 255, 255, 0.85);color:var(--color-text);font-size:var(--font-size-xs);font-weight:700}
.pin-item:hover img,.pin-item:focus-visible img{transform:scale(1.05);filter:brightness(0.95)}
.pin-item:hover .pin-overlay,.pin-item:focus-visible .pin-overlay{opacity:1}
@media(max-width:48rem){
  /* タッチデバイスでも控えめにキャプションを表示 */
  .pin-overlay{opacity:0.92}
}
@media(min-width:48rem){
  .instagram-grid{grid-template-columns:repeat(3,1fr);gap:var(--space-4)}
  .pin-overlay{padding:var(--space-4)}
}
</style>

