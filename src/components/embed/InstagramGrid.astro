---
import instagramData from '../../data/instagram.json';

interface InstagramPost {
  url: string;
  title?: string;
}

const posts: InstagramPost[] = instagramData.posts && instagramData.posts.length > 0
  ? instagramData.posts
  : [
      { url: 'https://www.instagram.com/p/DcxMB5nCfdN/', title: '最新の営業カレンダー' },
      { url: 'https://www.instagram.com/p/Dcw6v08TK7w/', title: 'オープンとラインナップ' },
      { url: 'https://www.instagram.com/p/DcpHJHxz_oI/', title: 'こだわりパンとオリーブオイル' },
    ];
---
<div class="instagram-embed-wrapper">
  <div class="instagram-cards-grid">
    {posts.map((post) => (
      <div class="instagram-card">
        <blockquote
          class="instagram-media"
          data-instgrm-captioned
          data-instgrm-permalink={post.url}
          data-instgrm-version="14"
          style="background:#FFF; border:0; border-radius:12px; box-shadow:0 0 1px 0 rgba(0,0,0,0.3),0 2px 12px 0 rgba(0,0,0,0.08); margin: 0 auto; max-width:540px; min-width:300px; padding:0; width:100%;"
        >
          <div style="padding:16px; text-align:center;">
            <a href={post.url} target="_blank" rel="noopener noreferrer" style="color:#c13584; font-weight:700; text-decoration:none;">
              {post.title || 'Instagram で投稿を見る'} ↗
            </a>
          </div>
        </blockquote>
      </div>
    ))}
  </div>
</div>

<script is:inline src="//www.instagram.com/embed.js"></script>
<script is:inline>
  // Ensure embeds process properly when navigating
  if (window.instgrm?.Embeds) {
    window.instgrm.Embeds.process();
  }
</script>

<style>
.instagram-embed-wrapper{width:100%;margin:var(--space-6) auto 0}
.instagram-cards-grid{display:grid;grid-template-columns:1fr;gap:var(--space-6);justify-items:center}
.instagram-card{width:100%;max-width:540px;display:flex;justify-content:center}
@media(min-width:48rem){
  .instagram-cards-grid{grid-template-columns:repeat(2,1fr);align-items:start}
}
@media(min-width:72rem){
  .instagram-cards-grid{grid-template-columns:repeat(3,1fr)}
}
</style>


