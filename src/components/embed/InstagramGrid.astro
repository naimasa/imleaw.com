---
import { siteConfig } from '../../config/site.config';
const images = ['/wp-content/uploads/2024/09/IMG_1527-scaled.jpg','/wp-content/uploads/2024/07/IMG_1422-scaled.jpg','/wp-content/uploads/2024/06/IMG_1323-scaled.jpg','/wp-content/uploads/2024/05/IMG_1263-scaled.jpg','/wp-content/uploads/2024/04/IMG_1092-scaled.jpg','/wp-content/uploads/2024/03/IMG_0868-scaled.jpg'];
---
<div class="instagram-grid">{images.map((src, i) => <a href={siteConfig.store.instagramUrl} target="_blank" rel="noopener"><img src={src} alt={`イム・レーオのパンと工房の風景 ${i + 1}`} width="640" height="640" loading="lazy" /><span class="visually-hidden">Instagramで見る（新しいタブ）</span></a>)}</div>
<style>.instagram-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-2)}.instagram-grid a{aspect-ratio:1;overflow:hidden;border-radius:var(--radius-sm);background:var(--color-surface-warm)}.instagram-grid img{width:100%;height:100%;object-fit:cover;transition:transform var(--transition)}.instagram-grid a:hover img{transform:scale(1.035)}@media(min-width:48rem){.instagram-grid{grid-template-columns:repeat(3,1fr);gap:var(--space-4)}}</style>
