---
import { siteConfig } from '../../config/site.config';
const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');
---
<nav id="primary-nav" class="nav" aria-label="メインナビゲーション">
  <ul>
    {siteConfig.nav.map((item) => <li><a href={item.href} aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a></li>)}
    <li>
      <a href="/search/" aria-current={currentPath === '/search/' ? 'page' : undefined} class="nav-search-link" title="サイト内検索">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <span>検索</span>
      </a>
    </li>
    <li class="lang-switch-item">
      {isEn ? (
        <a class="lang-badge" href="/" title="日本語ページへ切り替え">JA (日本語)</a>
      ) : (
        <a class="lang-badge" href="/en/" title="English Bakery Guide">EN (English)</a>
      )}
    </li>
  </ul>

</nav>
<style>
  .nav ul{display:flex;align-items:center;gap:var(--space-5);margin:0;padding:0;list-style:none}
  .nav a{color:var(--color-text);font-size:var(--font-size-sm);font-weight:700;text-decoration:none;white-space:nowrap}
  .nav a:hover,.nav a[aria-current=page]{color:var(--color-primary);text-decoration:underline}
  .nav a[aria-current=page]{text-decoration-thickness:2px}
  .lang-switch-item{margin-left:var(--space-2)}
  .lang-badge{display:inline-flex;align-items:center;padding:var(--space-1) var(--space-3);border:1.5px solid var(--color-primary);border-radius:var(--radius-pill);background:var(--color-surface);color:var(--color-primary)!important;font-size:var(--font-size-xs);font-weight:700;line-height:1.4;text-decoration:none!important;transition:all var(--transition)}
  .lang-badge:hover{background:var(--color-primary);color:var(--color-white)!important}
  @media(max-width:63.99rem){
    .nav{position:absolute;top:100%;left:0;width:100%;padding:var(--space-4) var(--space-5) var(--space-6);background:var(--color-surface);border-bottom:1px solid var(--color-border);box-shadow:var(--shadow-md)}
    .nav[hidden]{display:none}
    .nav ul{align-items:stretch;flex-direction:column;gap:0}
    .nav a{display:block;padding:var(--space-3) 0;font-size:var(--font-size-base)}
    .lang-switch-item{margin-left:0;margin-top:var(--space-3);padding-top:var(--space-3);border-top:1px solid var(--color-border)}
    .lang-badge{display:inline-block;text-align:center;width:auto}
  }
</style>

